// Showcall — Showcall Productions event operations. Synthetic data only.
//
// Times are minute-of-day on a local date in the event's timezone: a run
// sheet is "9:05 in Ballroom A on day 2", never an instant, so no DST change
// or server timezone can move a cue. Range checks live in the init migration.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Client {
  id     String  @id @default(cuid())
  name   String  @unique
  events Event[]
}

model Event {
  id              String                @id @default(cuid())
  name            String
  timezone        String
  startDate       DateTime              @db.Date
  endDate         DateTime              @db.Date
  client          Client                @relation(fields: [clientId], references: [id])
  clientId        String
  rooms           Room[]
  speakers        Speaker[]
  sessions        Session[]
  versions        AgendaVersion[]
  cues            Cue[]
  roles           CallRole[]
  marks           LiveMark[]
  staffing        Assignment[]
  sponsors        Sponsor[]
  deliverables    Deliverable[]
  rules           ValidationRule[]
  packages        DistributionPackage[]
  deadlines       DeadlinePolicy[]
  budget          BudgetLine[]
  snapshots       BudgetSnapshot[]
  /// The client's approval link (P1-6, D-028): SHA-256 of the raw token.
  clientTokenHash String?               @unique
  nags            ComplianceReminder[]
  blocks          RoomBlock[]
  registrations   Registration[]
  rfps            Rfp[]
  plans           ContingencyPlan[]
  venue           Venue?                @relation(fields: [venueId], references: [id])
  venueId         String?
  crewRules       CrewRules?
  /// The agenda version the run sheet is built from; stale when behind (D-003).
  runSheetVersion Int                   @default(0)
}

/// Turnover between two sessions in a room is strike + reset.
model Room {
  id            String                @id @default(cuid())
  name          String
  strikeMinutes Int                   @default(0)
  resetMinutes  Int                   @default(0)
  /// What the space can take (D-024). Null ceiling is open air.
  ceilingFt     Int?
  rigPoints     Int                   @default(0)
  rigPointLbs   Int                   @default(0)
  powerAmps     Int                   @default(0)
  event         Event                 @relation(fields: [eventId], references: [id])
  eventId       String
  sessions      Session[]
  cues          Cue[]
  marks         LiveMark[]
  staffing      Assignment[]
  packages      DistributionPackage[]

  @@unique([eventId, name])
}

enum SpeakerState {
  invited
  confirmed
  contracted
  content_complete
  rehearsed
  showed
  released
}

/// P0-4 bureau. Lifecycle and consent fields; see src/bureau/bureau.ts.
model Speaker {
  id       String           @id @default(cuid())
  name     String
  event    Event            @relation(fields: [eventId], references: [id])
  eventId  String
  sessions SessionSpeaker[]

  state            SpeakerState @default(invited)
  bio              String       @default("")
  /// Filled by S-8's upload pipeline; S-10 flags its absence.
  headshotUrl      String?
  avNeeds          String       @default("")
  /// Integer cents (hard rule 4).
  honorariumCents  Int?
  /// The e-sign seam.
  contractSignedAt DateTime?

  /// Stamped when the three flags below were last recorded — "on file", not that they are all yes.
  consentRecordedAt     DateTime?
  consentRecordSession  Boolean   @default(false)
  consentDistributeDeck Boolean   @default(false)
  consentPublishVideo   Boolean   @default(false)

  transitions     SpeakerTransition[]
  /// SHA-256 of the portal token; the raw token is shown once. Reissue overwrites, killing the old link.
  portalTokenHash String?             @unique
  deliverables    Deliverable[]
  rooms           RoomReservation[]
}

/// Append-only (trigger): every lifecycle move, including a producer's correction back.
model SpeakerTransition {
  id        String       @id @default(cuid())
  speaker   Speaker      @relation(fields: [speakerId], references: [id])
  speakerId String
  from      SpeakerState
  to        SpeakerState
  /// Required on a step back; empty on a forward advance.
  reason    String       @default("")
  at        DateTime

  @@index([speakerId])
}

/// The draft grid. Edits are free; only a conflict-free grid publishes.
model Session {
  id          String           @id @default(cuid())
  title       String
  day         DateTime         @db.Date
  startMin    Int
  endMin      Int
  event       Event            @relation(fields: [eventId], references: [id])
  eventId     String
  room        Room             @relation(fields: [roomId], references: [id])
  roomId      String
  speakers    SessionSpeaker[]
  /// A rehearsal is a session that is not on the public agenda (D-013): same
  /// conflict engine, excluded from publishAgenda's snapshot.
  isRehearsal Boolean          @default(false)

  @@index([eventId, day])
}

model SessionSpeaker {
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  speaker   Speaker @relation(fields: [speakerId], references: [id])
  speakerId String

  @@id([sessionId, speakerId])
}

/// Append-only (a trigger refuses UPDATE and DELETE). Downstream artifacts
/// record the version they were built from; stale is that number being behind.
model AgendaVersion {
  id          String   @id @default(cuid())
  number      Int
  /// The public-safe projection only — see src/agenda/publish.ts.
  snapshot    Json
  publishedAt DateTime
  event       Event    @relation(fields: [eventId], references: [id])
  eventId     String

  @@unique([eventId, number])
}

enum Edge {
  start
  end
}

/// A run-sheet cue. Its time is never stored: it is fixed (day + startMin) or
/// anchored to a session or another cue's edge plus an offset, and derives
/// from there (src/runsheet/cues.ts). Shape rules live in the migration.
model Cue {
  id             String           @id @default(cuid())
  label          String
  durationMin    Int
  day            DateTime?        @db.Date
  startMin       Int?
  /// A session id from the agenda snapshot, or a cue id. No foreign key:
  /// sessions are referenced as published, and a vanished anchor is a
  /// problem the cascade names rather than a row the database deletes.
  anchorId       String?
  anchorEdge     Edge?
  offsetMin      Int              @default(0)
  /// Optional "must end by" — the cue's slack is measured against it.
  endById        String?
  endByEdge      Edge?
  endByOffsetMin Int              @default(0)
  event          Event            @relation(fields: [eventId], references: [id])
  eventId        String
  room           Room             @relation(fields: [roomId], references: [id])
  roomId         String
  roles          CueRole[]
  plan           ContingencyPlan?
  load           LoadSlot?

  @@index([eventId])
}

/// A call-sheet audience (D-008): "Florist", "A1 Audio". Cues are tagged to
/// the roles they concern, and a role's sheet shows exactly those cues.
model CallRole {
  id              String           @id @default(cuid())
  name            String
  /// Where to report: dock, entrance, contact. Printed on the sheet.
  reportTo        String           @default("")
  event           Event            @relation(fields: [eventId], references: [id])
  eventId         String
  cues            CueRole[]
  issues          CallSheetIssue[]
  /// SHA-256 of the crew-portal token (P1-3, D-026); the raw token is shown once. Reissue kills the old link.
  portalTokenHash String?          @unique
  /// The company behind this role, if any: its portal takes that vendor's COI.
  vendor          Vendor?          @relation(fields: [vendorId], references: [id])
  vendorId        String?
  coiSubmissions  CoiSubmission[]

  @@unique([eventId, name])
}

model CueRole {
  cue    Cue      @relation(fields: [cueId], references: [id], onDelete: Cascade)
  cueId  String
  role   CallRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId String

  @@id([cueId, roleId])
}

/// An issued call sheet. Append-only (trigger), like AgendaVersion: what a
/// role was sent is kept exactly, and the next issue diffs against it.
/// Crew work rules (P1-1, D-027): warnings on the run sheet, never refusals.
model CrewRules {
  event              Event  @relation(fields: [eventId], references: [id])
  eventId            String @id
  overtimeAfterMin   Int
  mealWithinMin      Int
  mealBreakMin       Int
  mealPenaltyCents   Int
  mealPenaltyStepMin Int
}

model CallSheetIssue {
  id            String            @id @default(cuid())
  number        Int
  /// The agenda version the run sheet was pinned to; stale when behind (D-003).
  agendaVersion Int
  /// The role's projection only — see src/callsheet/callsheet.ts.
  content       Json
  issuedAt      DateTime
  role          CallRole          @relation(fields: [roleId], references: [id])
  roleId        String
  receipt       CallSheetReceipt?

  @@unique([roleId, number])
}

/// The recipient confirmed they have this issue (P1-3). Append-only (trigger),
/// one per issue. The latest issue without one is still awaiting receipt.
model CallSheetReceipt {
  id          String         @id @default(cuid())
  issue       CallSheetIssue @relation(fields: [issueId], references: [id])
  issueId     String         @unique
  confirmedAt DateTime
}

/// Stage-manager live mode: a GO on a run-sheet row, stamped from the clock.
/// Append-only (trigger) — the show's actual timeline, never a cue edit. The
/// running offset derives from it (src/live/live.ts); a wrong GO is corrected
/// by the next GO, and the log keeps both for planned-vs-actual (P1-5).
model LiveMark {
  id         String   @id @default(cuid())
  /// A session id from the agenda snapshot, or a cue id — same as Cue.anchorId.
  rowId      String
  day        DateTime @db.Date
  /// The row's planned start when GO was called; the offset is actual − planned.
  plannedMin Int
  actualMin  Int
  markedAt   DateTime
  /// Who called it — the stage manager on duty for the room (D-011).
  staff      Staff    @relation(fields: [staffId], references: [id])
  staffId    String
  event      Event    @relation(fields: [eventId], references: [id])
  eventId    String
  room       Room     @relation(fields: [roomId], references: [id])
  roomId     String

  @@index([eventId, day])
}

/// A Showcall Productions staffer. Capacity is minutes on shift per day,
/// across every event (Groundwork's crew-day cap): a second show the same day
/// counts against the same person.
model Staff {
  id               String            @id @default(cuid())
  name             String            @unique
  maxMinutesPerDay Int               @default(720)
  assignments      Assignment[]
  marks            LiveMark[]
  rooms            RoomReservation[]
  plans            ContingencyPlan[]
}

enum DayRole {
  producer
  stage_manager
  technical_director
  crew
}

/// A day-of role: who works which event, which day, when, and where. A null
/// room is event-wide. Overlaps and over-capacity are refused (src/staffing).
model Assignment {
  id       String   @id @default(cuid())
  day      DateTime @db.Date
  startMin Int
  endMin   Int
  role     DayRole
  staff    Staff    @relation(fields: [staffId], references: [id])
  staffId  String
  event    Event    @relation(fields: [eventId], references: [id])
  eventId  String
  room     Room?    @relation(fields: [roomId], references: [id])
  roomId   String?

  @@index([staffId, day])
  @@index([eventId, day])
}

/// Content turn-in (P0-5, D-015). A sponsor owns deliverables like a speaker does.
model Sponsor {
  id              String        @id @default(cuid())
  name            String
  event           Event         @relation(fields: [eventId], references: [id])
  eventId         String
  portalTokenHash String?       @unique
  deliverables    Deliverable[]

  @@unique([eventId, name])
}

enum DeliverableKind {
  deck
  headshot
  logo
  banner
  booth_info
  video
}

/// One thing a speaker or sponsor owes. Exactly one owner (CHECK in the migration).
model Deliverable {
  id        String           @id @default(cuid())
  kind      DeliverableKind
  label     String
  event     Event            @relation(fields: [eventId], references: [id])
  eventId   String
  speaker   Speaker?         @relation(fields: [speakerId], references: [id])
  speakerId String?
  sponsor   Sponsor?         @relation(fields: [sponsorId], references: [id])
  sponsorId String?
  versions  ContentVersion[]
  locks     ShowFileLock[]
  reminders Reminder[]

  @@index([eventId])
}

/// An uploaded file. Append-only (trigger): v1…vN are all kept, numbers dense.
/// Facts come from the file (src/content/facts.ts), never from the uploader.
model ContentVersion {
  id            String           @id @default(cuid())
  deliverable   Deliverable      @relation(fields: [deliverableId], references: [id])
  deliverableId String
  number        Int
  filename      String
  mimeType      String
  bytes         Bytes
  byteSize      Int
  sha256        String
  facts         Json
  uploadedAt    DateTime
  runs          ValidationRun[]
  comments      VersionComment[]
  locks         ShowFileLock[]

  @@unique([deliverableId, number])
}

enum RuleCheck {
  max_bytes
  file_type
  aspect_ratio
  fonts_embedded
  min_pixels
  codec_allowlist
  manual
}

/// Rules are data, per event and deliverable kind; `fix` is shown on failure.
model ValidationRule {
  id      String          @id @default(cuid())
  kind    DeliverableKind
  check   RuleCheck
  params  Json
  fix     String
  event   Event           @relation(fields: [eventId], references: [id])
  eventId String

  @@index([eventId, kind])
}

enum ValidationOutcome {
  passed
  needs_review
  failed
}

/// Append-only: re-validation (S-9) adds a run beside the old one.
model ValidationRun {
  id        String            @id @default(cuid())
  version   ContentVersion    @relation(fields: [versionId], references: [id])
  versionId String
  outcome   ValidationOutcome
  results   Json
  at        DateTime

  @@index([versionId])
}

enum CommentSide {
  producer
  submitter
}

/// Append-only thread on a version.
model VersionComment {
  id              String         @id @default(cuid())
  version         ContentVersion @relation(fields: [versionId], references: [id])
  versionId       String
  side            CommentSide
  body            String
  requestsChanges Boolean        @default(false)
  at              DateTime

  @@index([versionId])
}

enum LockKind {
  approve
  override
}

/// Which version is the show file (D-016). Append-only (trigger); the latest
/// row (highest number) wins. Lock 1 is the approve, every later one an override with a reason.
model ShowFileLock {
  id            String         @id @default(cuid())
  number        Int
  deliverable   Deliverable    @relation(fields: [deliverableId], references: [id])
  deliverableId String
  version       ContentVersion @relation(fields: [versionId], references: [id])
  versionId     String
  kind          LockKind
  reason        String         @default("")
  at            DateTime

  @@unique([deliverableId, number])
}

enum Audience {
  room
  attendees
}

/// A built playback (room) or post-show (attendees) package (D-016).
/// Append-only (trigger). Stale when the manifest built now has another checksum.
model DistributionPackage {
  id            String   @id @default(cuid())
  audience      Audience
  number        Int
  /// The agenda version the running order was read from.
  agendaVersion Int
  manifest      Json
  /// SHA-256 of the manifest's canonical JSON.
  sha256        String
  builtAt       DateTime
  event         Event    @relation(fields: [eventId], references: [id])
  eventId       String
  /// Set for a room package, null for attendees (CHECK in the migration).
  room          Room?    @relation(fields: [roomId], references: [id])
  roomId        String?

  @@index([eventId, audience, roomId])
}

/// How far before the show a kind of deliverable is due (P0-5 chase). Lead
/// time is data, per event and kind, like ValidationRule — the deadline
/// itself is never stored: it derives from the owner's first call time minus
/// this (src/chase/chase.ts), so a session move moves the deadline with it.
model DeadlinePolicy {
  id       String          @id @default(cuid())
  kind     DeliverableKind
  leadDays Int
  event    Event           @relation(fields: [eventId], references: [id])
  eventId  String

  @@unique([eventId, kind])
}

/// The reminder outbox. Append-only (trigger): what went out, as it went out.
/// One row per deliverable per cadence step — the unique key is the cadence,
/// so no step can be sent twice however often the producer clicks.
model Reminder {
  id            String      @id @default(cuid())
  deliverable   Deliverable @relation(fields: [deliverableId], references: [id])
  deliverableId String
  /// Days before due that this reminder covers; negative is after (overdue).
  step          Int
  to            String
  body          String
  sentAt        DateTime

  @@unique([deliverableId, step])
}

/// A company Showcall buys from. House-wide, like Staff: one caterer across
/// every event, one COI on file for all of them.
model Vendor {
  id             String               @id @default(cuid())
  name           String               @unique
  docs           ComplianceDoc[]
  lines          BudgetLine[]
  nags           ComplianceReminder[]
  blocks         RoomBlock[]
  quotes         Quote[]
  notices        ContingencyNotice[]
  costs          ContingencyBranch[]
  loads          LoadSlot[]
  roles          CallRole[]
  coiSubmissions CoiSubmission[]
}

enum ComplianceKind {
  coi
  w9
}

/// A compliance document received. Append-only (trigger): a renewal is a new
/// row, and the one in force is the latest received. A W-9 does not expire; a
/// COI must (check constraint).
model ComplianceDoc {
  id         String         @id @default(cuid())
  kind       ComplianceKind
  receivedOn DateTime       @db.Date
  expiresOn  DateTime?      @db.Date
  vendor     Vendor         @relation(fields: [vendorId], references: [id])
  vendorId   String
  submission CoiSubmission?
}

/// A COI uploaded through the crew portal (D-026). Pending until a producer
/// accepts it, which records the ComplianceDoc — an unauthenticated upload
/// never clears compliance on its own. Append-only except the one accept.
model CoiSubmission {
  id              String         @id @default(cuid())
  vendor          Vendor         @relation(fields: [vendorId], references: [id])
  vendorId        String
  /// The portal it came through.
  role            CallRole       @relation(fields: [roleId], references: [id])
  roleId          String
  filename        String
  mimeType        String
  bytes           Bytes
  byteSize        Int
  /// What the vendor says; the producer confirms it on accept.
  statedExpiresOn DateTime       @db.Date
  submittedAt     DateTime
  doc             ComplianceDoc? @relation(fields: [docId], references: [id])
  docId           String?        @unique
}

/// The compliance nag outbox (D-019) — Reminder's sibling, not a
/// generalization of it. Append-only. The cadence is the unique key again, and
/// `dueOn` is in it, so a renewal that moves the due day starts a fresh cadence.
model ComplianceReminder {
  id       String         @id @default(cuid())
  event    Event          @relation(fields: [eventId], references: [id])
  eventId  String
  vendor   Vendor         @relation(fields: [vendorId], references: [id])
  vendorId String
  kind     ComplianceKind
  dueOn    DateTime       @db.Date
  step     Int
  body     String
  sentAt   DateTime

  @@unique([eventId, vendorId, kind, dueOn, step])
}

enum BudgetCategory {
  venue
  av
  catering
  decor
  staffing
  talent
  travel
  production
  other
}

/// One line of an event's budget (P0-8). Integer cents, never negative.
/// Committed is what is contracted; actual is what has been invoiced. Lines
/// are working state — the history is the snapshots.
model BudgetLine {
  id             String               @id @default(cuid())
  category       BudgetCategory
  description    String
  committedCents Int
  actualCents    Int                  @default(0)
  clientBillable Boolean              @default(true)
  event          Event                @relation(fields: [eventId], references: [id])
  eventId        String
  vendor         Vendor?              @relation(fields: [vendorId], references: [id])
  vendorId       String?
  attrition      AttritionDecision?
  contract       Contract?
  contingency    ContingencyDecision?

  @@index([eventId])
}

/// A frozen copy of the budget. Append-only (trigger), numbered per event.
/// `lines` is the full line list as it stood; totals are columns so a
/// comparison never re-adds JSON.
model BudgetSnapshot {
  id             String   @id @default(cuid())
  number         Int
  label          String
  takenAt        DateTime
  committedCents Int
  actualCents    Int
  billableCents  Int
  lines          Json
  /// The close (D-025): at most one per event (partial unique index), and
  /// once it exists the database refuses every write to the event's lines.
  final          Boolean  @default(false)
  /// Sent to the client (D-028): the client's portal shows the latest one.
  forClient      Boolean  @default(false)
  event          Event    @relation(fields: [eventId], references: [id])
  eventId        String
  approval       BudgetApproval?

  @@unique([eventId, number])
}

/// The client's answer on a sent snapshot (P1-6, D-028). One per snapshot,
/// append-only (trigger). The latest approved snapshot is the baseline:
/// billable spend above it is unapproved and blocks the close.
model BudgetApproval {
  id         String         @id @default(cuid())
  snapshot   BudgetSnapshot @relation(fields: [snapshotId], references: [id])
  snapshotId String         @unique
  approved   Boolean
  /// Who the client says they are. The link is not an identity.
  signedBy   String
  /// Why, when declined (check constraint).
  note       String?
  decidedAt  DateTime
}

/// A negotiated hotel block (P0-5): rooms × nights × rate. The hotel is a
/// Vendor, so accepted exposure lands on the budget against it (D-020).
model RoomBlock {
  id           String               @id @default(cuid())
  event        Event                @relation(fields: [eventId], references: [id])
  eventId      String
  hotel        Vendor               @relation(fields: [hotelId], references: [id])
  hotelId      String
  rateCents    Int
  /// Pickup pace is measured from the day the contract was signed.
  contractedOn DateTime             @db.Date
  /// After this day the hotel takes unsold rooms back: nothing books or releases.
  cutoffOn     DateTime             @db.Date
  nights       BlockNight[]
  thresholds   AttritionThreshold[]
  reservations RoomReservation[]
  decisions    AttritionDecision[]
}

/// Rooms contracted on one night, as signed. Releases never edit this; they are decisions.
model BlockNight {
  id       String         @id @default(cuid())
  block    RoomBlock      @relation(fields: [blockId], references: [id])
  blockId  String
  night    DateTime       @db.Date
  rooms    Int
  released BlockRelease[]

  @@unique([blockId, night])
}

/// "Fill `percent`% of contracted room-nights by `dueOn`, or pay the shortfall at the block rate."
model AttritionThreshold {
  id        String              @id @default(cuid())
  block     RoomBlock           @relation(fields: [blockId], references: [id])
  blockId   String
  dueOn     DateTime            @db.Date
  percent   Int
  decisions AttritionDecision[]

  @@unique([blockId, dueOn])
}

enum GuestKind {
  attendee
  speaker
  staff
  vip
}

/// Rooms booked into the block. Speaker and staff rooms link their person (CHECK).
model RoomReservation {
  id        String    @id @default(cuid())
  block     RoomBlock @relation(fields: [blockId], references: [id])
  blockId   String
  kind      GuestKind
  guest     String
  rooms     Int       @default(1)
  arriveOn  DateTime  @db.Date
  departOn  DateTime  @db.Date
  bookedOn  DateTime  @db.Date
  speaker   Speaker?  @relation(fields: [speakerId], references: [id])
  speakerId String?
  staff     Staff?    @relation(fields: [staffId], references: [id])
  staffId   String?

  @@index([blockId])
}

enum AttritionChoice {
  release
  accept
}

/// A decision answering a threshold's alert. Append-only (trigger): the log is the record.
/// A release carries its per-night split; an accept carries the budget line it posted.
model AttritionDecision {
  id            String             @id @default(cuid())
  block         RoomBlock          @relation(fields: [blockId], references: [id])
  blockId       String
  threshold     AttritionThreshold @relation(fields: [thresholdId], references: [id])
  thresholdId   String
  choice        AttritionChoice
  roomNights    Int
  /// What an accept added to the budget (net of earlier accepts); 0 for a release.
  exposureCents Int
  decidedOn     DateTime           @db.Date
  decidedAt     DateTime
  releases      BlockRelease[]
  budgetLine    BudgetLine?        @relation(fields: [budgetLineId], references: [id], onDelete: Restrict)
  budgetLineId  String?            @unique
}

/// Rooms handed back to the hotel on one night. Append-only.
model BlockRelease {
  id         String            @id @default(cuid())
  decision   AttritionDecision @relation(fields: [decisionId], references: [id])
  decisionId String
  night      BlockNight        @relation(fields: [nightId], references: [id])
  nightId    String
  rooms      Int
}

// ── RFP normalization (P0-6, D-021) ─────────────────────────────────────────

/// Registration headcount by attendee type against capacity (P0-8). Working
/// state: counts move as people register. Their sum is the per-head quantity.
model Registration {
  id           String @id @default(cuid())
  event        Event  @relation(fields: [eventId], references: [id])
  eventId      String
  attendeeType String
  registered   Int
  capacity     Int

  @@unique([eventId, attendeeType])
}

/// How a line's quantity is found: the headcount, a count on the RFP, or one.
enum LineBasis {
  per_head
  each
  flat
}

/// The line-item schema per category, as data. An RFP copies it at creation,
/// so editing the schema never rewrites an RFP already out to vendors.
model LineSchema {
  id       String         @id @default(cuid())
  category BudgetCategory
  label    String
  basis    LineBasis
  position Int

  @@unique([category, label])
}

model Rfp {
  id        String         @id @default(cuid())
  event     Event          @relation(fields: [eventId], references: [id])
  eventId   String
  category  BudgetCategory
  title     String
  createdAt DateTime
  items     RfpItem[]
  quotes    Quote[]
  contract  Contract?
}

model RfpItem {
  id       String      @id @default(cuid())
  rfp      Rfp         @relation(fields: [rfpId], references: [id])
  rfpId    String
  label    String
  basis    LineBasis
  /// Set for `each` lines only.
  quantity Int?
  position Int
  answers  QuoteLine[]

  @@unique([rfpId, label])
}

enum Inclusion {
  included
  excluded
  extra
}

/// A vendor's answer, normalized: a base price that covers every `included`
/// line, plus each `extra` line at unit × quantity. `excluded` is a gap.
model Quote {
  id          String      @id @default(cuid())
  rfp         Rfp         @relation(fields: [rfpId], references: [id])
  rfpId       String
  vendor      Vendor      @relation(fields: [vendorId], references: [id])
  vendorId    String
  baseCents   Int
  basePerHead Boolean
  receivedOn  DateTime    @db.Date
  lines       QuoteLine[]
  contract    Contract?

  @@unique([rfpId, vendorId])
}

model QuoteLine {
  id        String    @id @default(cuid())
  quote     Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteId   String
  item      RfpItem   @relation(fields: [itemId], references: [id])
  itemId    String
  inclusion Inclusion
  /// Set for `extra` lines only.
  unitCents Int?

  @@unique([quoteId, itemId])
}

enum ContractStatus {
  awarded
  sent
  signed
}

/// The award: one per RFP, landing as a budget commitment in the same
/// transaction. What was outstanding at that moment is recorded, not re-derived.
model Contract {
  id             String         @id @default(cuid())
  rfp            Rfp            @relation(fields: [rfpId], references: [id])
  rfpId          String         @unique
  quote          Quote          @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  quoteId        String         @unique
  budgetLine     BudgetLine     @relation(fields: [budgetLineId], references: [id], onDelete: Restrict)
  budgetLineId   String         @unique
  committedCents Int
  headcount      Int
  /// Compliance papers outstanding at award, e.g. "certificate of insurance expires Mon, Nov 2, before the show ends".
  papers         String[]
  /// Lines the awarded quote excludes — still to source elsewhere.
  gaps           String[]
  status         ContractStatus @default(awarded)
  awardedAt      DateTime
  statusAt       DateTime
}

/// A contingency plan (P0-7, D-022): what would trigger it, who calls it and by
/// when. The decide-by is a run-sheet cue, so it derives like any other
/// (D-006): anchored to the reception, it moves with the reception.
model ContingencyPlan {
  id            String                  @id @default(cuid())
  title         String
  /// The criteria, as the producer would say them on a call.
  trigger       String
  event         Event                   @relation(fields: [eventId], references: [id])
  eventId       String
  owner         Staff                   @relation(fields: [ownerId], references: [id])
  ownerId       String
  decideBy      Cue                     @relation(fields: [decideByCueId], references: [id])
  decideByCueId String                  @unique
  branches      ContingencyBranch[]
  decision      ContingencyDecision?
  escalations   ContingencyEscalation[]

  @@unique([eventId, title])
}

/// One way the call can go, and the cascade it implies. Executed in S-17.
model ContingencyBranch {
  id             String                @id @default(cuid())
  label          String
  /// The run-sheet variant: cue edits in the cascade's shape (BranchEdit[]).
  cueEdits       Json
  /// Non-negative: it posts to the budget as a committed line (D-022).
  costDeltaCents Int                   @default(0)
  costCategory   BudgetCategory        @default(other)
  costVendor     Vendor?               @relation(fields: [costVendorId], references: [id])
  costVendorId   String?
  plan           ContingencyPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  planId         String
  notices        ContingencyNotice[]
  decisions      ContingencyDecision[]

  @@unique([planId, label])
}

/// What a vendor is told if this branch is taken.
model ContingencyNotice {
  id       String            @id @default(cuid())
  body     String
  branch   ContingencyBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  branchId String
  vendor   Vendor            @relation(fields: [vendorId], references: [id])
  vendorId String
}

/// The call, once made, and what it did. Append-only (trigger); one per plan.
/// Written in the cascade's own transaction (D-023): the cue edits, this row
/// and the cost line land together or not at all. The taken branch's notices
/// went out at `decidedAt`; the branches not taken stay on the plan, unchanged.
model ContingencyDecision {
  id           String            @id @default(cuid())
  decidedAt    DateTime
  plan         ContingencyPlan   @relation(fields: [planId], references: [id])
  planId       String            @unique
  branch       ContingencyBranch @relation(fields: [branchId], references: [id])
  branchId     String
  /// The cascade as committed — exactly the preview that was shown (Moved[]).
  moved        Json
  budgetLine   BudgetLine?       @relation(fields: [budgetLineId], references: [id], onDelete: Restrict)
  budgetLineId String?           @unique
}

/// The escalation outbox: an unmade decision at its decide-by. Append-only.
/// The deadline is in the unique key, so a decide-by that moves later starts
/// afresh, and one deadline escalates once however often the sweep runs.
model ContingencyEscalation {
  id     String          @id @default(cuid())
  plan   ContingencyPlan @relation(fields: [planId], references: [id])
  planId String
  day    DateTime        @db.Date
  minute Int
  to     String
  body   String
  sentAt DateTime

  @@unique([planId, day, minute])
}

/// A venue's house facts as structured data (P0-8, D-024). Building-wide:
/// the dock and its hours, wifi, union house rules. What each space can take
/// (ceiling, rigging, power) is on Room.
model Venue {
  id           String  @id @default(cuid())
  name         String  @unique
  dockBays     Int
  /// House dock hours: every load slot runs inside them.
  dockOpenMin  Int
  dockCloseMin Int
  maxTruckFt   Int
  wifiMbps     Int
  /// A union house bills a load call shorter than the minimum as the minimum.
  unionHouse   Boolean @default(false)
  minCallMin   Int     @default(0)
  events       Event[]
}

enum LoadKind {
  load_in
  load_out
}

/// A load-in or load-out slot, planned against the venue (D-024). Its time is
/// its cue's, so an anchored load-out moves with what it follows, and the
/// cascade refuses any change that breaks the venue's rules.
model LoadSlot {
  id          String   @id @default(cuid())
  kind        LoadKind
  vendor      Vendor   @relation(fields: [vendorId], references: [id])
  vendorId    String
  /// Dock bays held for the whole slot.
  trucks      Int
  truckFt     Int
  rigPoints   Int      @default(0)
  rigPointLbs Int      @default(0)
  powerAmps   Int      @default(0)
  /// Trim height the rig needs.
  ceilingFt   Int      @default(0)
  cue         Cue      @relation(fields: [cueId], references: [id])
  cueId       String   @unique
}
