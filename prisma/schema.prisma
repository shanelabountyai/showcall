// Showcall — Showcall Productions event operations. Synthetic data only.
//
// Times are minute-of-day on a local date in the event's timezone: a run
// sheet is "9:05 in Ballroom A on day 2", never an instant, so no DST change
// or server timezone can move a cue. Range checks live in the init migration.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Client {
  id     String  @id @default(cuid())
  name   String  @unique
  events Event[]
}

model Event {
  id              String                @id @default(cuid())
  name            String
  timezone        String
  startDate       DateTime              @db.Date
  endDate         DateTime              @db.Date
  client          Client                @relation(fields: [clientId], references: [id])
  clientId        String
  rooms           Room[]
  speakers        Speaker[]
  sessions        Session[]
  versions        AgendaVersion[]
  cues            Cue[]
  roles           CallRole[]
  marks           LiveMark[]
  staffing        Assignment[]
  sponsors        Sponsor[]
  deliverables    Deliverable[]
  rules           ValidationRule[]
  packages        DistributionPackage[]
  deadlines       DeadlinePolicy[]
  budget          BudgetLine[]
  snapshots       BudgetSnapshot[]
  nags            ComplianceReminder[]
  blocks          RoomBlock[]
  /// The agenda version the run sheet is built from; stale when behind (D-003).
  runSheetVersion Int                   @default(0)
}

/// Turnover between two sessions in a room is strike + reset.
model Room {
  id            String                @id @default(cuid())
  name          String
  strikeMinutes Int                   @default(0)
  resetMinutes  Int                   @default(0)
  event         Event                 @relation(fields: [eventId], references: [id])
  eventId       String
  sessions      Session[]
  cues          Cue[]
  marks         LiveMark[]
  staffing      Assignment[]
  packages      DistributionPackage[]

  @@unique([eventId, name])
}

enum SpeakerState {
  invited
  confirmed
  contracted
  content_complete
  rehearsed
  showed
  released
}

/// P0-4 bureau. Lifecycle and consent fields; see src/bureau/bureau.ts.
model Speaker {
  id       String           @id @default(cuid())
  name     String
  event    Event            @relation(fields: [eventId], references: [id])
  eventId  String
  sessions SessionSpeaker[]

  state            SpeakerState @default(invited)
  bio              String       @default("")
  /// Filled by S-8's upload pipeline; S-10 flags its absence.
  headshotUrl      String?
  avNeeds          String       @default("")
  /// Integer cents (hard rule 4).
  honorariumCents  Int?
  /// The e-sign seam.
  contractSignedAt DateTime?

  /// Stamped when the three flags below were last recorded — "on file", not that they are all yes.
  consentRecordedAt     DateTime?
  consentRecordSession  Boolean   @default(false)
  consentDistributeDeck Boolean   @default(false)
  consentPublishVideo   Boolean   @default(false)

  transitions     SpeakerTransition[]
  /// SHA-256 of the portal token; the raw token is shown once. Reissue overwrites, killing the old link.
  portalTokenHash String?             @unique
  deliverables    Deliverable[]
  rooms           RoomReservation[]
}

/// Append-only (trigger): every lifecycle move, including a producer's correction back.
model SpeakerTransition {
  id        String       @id @default(cuid())
  speaker   Speaker      @relation(fields: [speakerId], references: [id])
  speakerId String
  from      SpeakerState
  to        SpeakerState
  /// Required on a step back; empty on a forward advance.
  reason    String       @default("")
  at        DateTime

  @@index([speakerId])
}

/// The draft grid. Edits are free; only a conflict-free grid publishes.
model Session {
  id          String           @id @default(cuid())
  title       String
  day         DateTime         @db.Date
  startMin    Int
  endMin      Int
  event       Event            @relation(fields: [eventId], references: [id])
  eventId     String
  room        Room             @relation(fields: [roomId], references: [id])
  roomId      String
  speakers    SessionSpeaker[]
  /// A rehearsal is a session that is not on the public agenda (D-013): same
  /// conflict engine, excluded from publishAgenda's snapshot.
  isRehearsal Boolean          @default(false)

  @@index([eventId, day])
}

model SessionSpeaker {
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  speaker   Speaker @relation(fields: [speakerId], references: [id])
  speakerId String

  @@id([sessionId, speakerId])
}

/// Append-only (a trigger refuses UPDATE and DELETE). Downstream artifacts
/// record the version they were built from; stale is that number being behind.
model AgendaVersion {
  id          String   @id @default(cuid())
  number      Int
  /// The public-safe projection only — see src/agenda/publish.ts.
  snapshot    Json
  publishedAt DateTime
  event       Event    @relation(fields: [eventId], references: [id])
  eventId     String

  @@unique([eventId, number])
}

enum Edge {
  start
  end
}

/// A run-sheet cue. Its time is never stored: it is fixed (day + startMin) or
/// anchored to a session or another cue's edge plus an offset, and derives
/// from there (src/runsheet/cues.ts). Shape rules live in the migration.
model Cue {
  id             String    @id @default(cuid())
  label          String
  durationMin    Int
  day            DateTime? @db.Date
  startMin       Int?
  /// A session id from the agenda snapshot, or a cue id. No foreign key:
  /// sessions are referenced as published, and a vanished anchor is a
  /// problem the cascade names rather than a row the database deletes.
  anchorId       String?
  anchorEdge     Edge?
  offsetMin      Int       @default(0)
  /// Optional "must end by" — the cue's slack is measured against it.
  endById        String?
  endByEdge      Edge?
  endByOffsetMin Int       @default(0)
  event          Event     @relation(fields: [eventId], references: [id])
  eventId        String
  room           Room      @relation(fields: [roomId], references: [id])
  roomId         String
  roles          CueRole[]

  @@index([eventId])
}

/// A call-sheet audience (D-008): "Florist", "A1 Audio". Cues are tagged to
/// the roles they concern, and a role's sheet shows exactly those cues.
model CallRole {
  id       String           @id @default(cuid())
  name     String
  /// Where to report: dock, entrance, contact. Printed on the sheet.
  reportTo String           @default("")
  event    Event            @relation(fields: [eventId], references: [id])
  eventId  String
  cues     CueRole[]
  issues   CallSheetIssue[]

  @@unique([eventId, name])
}

model CueRole {
  cue    Cue      @relation(fields: [cueId], references: [id], onDelete: Cascade)
  cueId  String
  role   CallRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId String

  @@id([cueId, roleId])
}

/// An issued call sheet. Append-only (trigger), like AgendaVersion: what a
/// role was sent is kept exactly, and the next issue diffs against it.
model CallSheetIssue {
  id            String   @id @default(cuid())
  number        Int
  /// The agenda version the run sheet was pinned to; stale when behind (D-003).
  agendaVersion Int
  /// The role's projection only — see src/callsheet/callsheet.ts.
  content       Json
  issuedAt      DateTime
  role          CallRole @relation(fields: [roleId], references: [id])
  roleId        String

  @@unique([roleId, number])
}

/// Stage-manager live mode: a GO on a run-sheet row, stamped from the clock.
/// Append-only (trigger) — the show's actual timeline, never a cue edit. The
/// running offset derives from it (src/live/live.ts); a wrong GO is corrected
/// by the next GO, and the log keeps both for planned-vs-actual (P1-5).
model LiveMark {
  id         String   @id @default(cuid())
  /// A session id from the agenda snapshot, or a cue id — same as Cue.anchorId.
  rowId      String
  day        DateTime @db.Date
  /// The row's planned start when GO was called; the offset is actual − planned.
  plannedMin Int
  actualMin  Int
  markedAt   DateTime
  /// Who called it — the stage manager on duty for the room (D-011).
  staff      Staff    @relation(fields: [staffId], references: [id])
  staffId    String
  event      Event    @relation(fields: [eventId], references: [id])
  eventId    String
  room       Room     @relation(fields: [roomId], references: [id])
  roomId     String

  @@index([eventId, day])
}

/// A Showcall Productions staffer. Capacity is minutes on shift per day,
/// across every event (Groundwork's crew-day cap): a second show the same day
/// counts against the same person.
model Staff {
  id               String            @id @default(cuid())
  name             String            @unique
  maxMinutesPerDay Int               @default(720)
  assignments      Assignment[]
  marks            LiveMark[]
  rooms            RoomReservation[]
}

enum DayRole {
  producer
  stage_manager
  technical_director
  crew
}

/// A day-of role: who works which event, which day, when, and where. A null
/// room is event-wide. Overlaps and over-capacity are refused (src/staffing).
model Assignment {
  id       String   @id @default(cuid())
  day      DateTime @db.Date
  startMin Int
  endMin   Int
  role     DayRole
  staff    Staff    @relation(fields: [staffId], references: [id])
  staffId  String
  event    Event    @relation(fields: [eventId], references: [id])
  eventId  String
  room     Room?    @relation(fields: [roomId], references: [id])
  roomId   String?

  @@index([staffId, day])
  @@index([eventId, day])
}

/// Content turn-in (P0-5, D-015). A sponsor owns deliverables like a speaker does.
model Sponsor {
  id              String        @id @default(cuid())
  name            String
  event           Event         @relation(fields: [eventId], references: [id])
  eventId         String
  portalTokenHash String?       @unique
  deliverables    Deliverable[]

  @@unique([eventId, name])
}

enum DeliverableKind {
  deck
  headshot
  logo
  banner
  booth_info
  video
}

/// One thing a speaker or sponsor owes. Exactly one owner (CHECK in the migration).
model Deliverable {
  id        String           @id @default(cuid())
  kind      DeliverableKind
  label     String
  event     Event            @relation(fields: [eventId], references: [id])
  eventId   String
  speaker   Speaker?         @relation(fields: [speakerId], references: [id])
  speakerId String?
  sponsor   Sponsor?         @relation(fields: [sponsorId], references: [id])
  sponsorId String?
  versions  ContentVersion[]
  locks     ShowFileLock[]
  reminders Reminder[]

  @@index([eventId])
}

/// An uploaded file. Append-only (trigger): v1…vN are all kept, numbers dense.
/// Facts come from the file (src/content/facts.ts), never from the uploader.
model ContentVersion {
  id            String           @id @default(cuid())
  deliverable   Deliverable      @relation(fields: [deliverableId], references: [id])
  deliverableId String
  number        Int
  filename      String
  mimeType      String
  bytes         Bytes
  byteSize      Int
  sha256        String
  facts         Json
  uploadedAt    DateTime
  runs          ValidationRun[]
  comments      VersionComment[]
  locks         ShowFileLock[]

  @@unique([deliverableId, number])
}

enum RuleCheck {
  max_bytes
  file_type
  aspect_ratio
  fonts_embedded
  min_pixels
  codec_allowlist
  manual
}

/// Rules are data, per event and deliverable kind; `fix` is shown on failure.
model ValidationRule {
  id      String          @id @default(cuid())
  kind    DeliverableKind
  check   RuleCheck
  params  Json
  fix     String
  event   Event           @relation(fields: [eventId], references: [id])
  eventId String

  @@index([eventId, kind])
}

enum ValidationOutcome {
  passed
  needs_review
  failed
}

/// Append-only: re-validation (S-9) adds a run beside the old one.
model ValidationRun {
  id        String            @id @default(cuid())
  version   ContentVersion    @relation(fields: [versionId], references: [id])
  versionId String
  outcome   ValidationOutcome
  results   Json
  at        DateTime

  @@index([versionId])
}

enum CommentSide {
  producer
  submitter
}

/// Append-only thread on a version.
model VersionComment {
  id              String         @id @default(cuid())
  version         ContentVersion @relation(fields: [versionId], references: [id])
  versionId       String
  side            CommentSide
  body            String
  requestsChanges Boolean        @default(false)
  at              DateTime

  @@index([versionId])
}

enum LockKind {
  approve
  override
}

/// Which version is the show file (D-016). Append-only (trigger); the latest
/// row (highest number) wins. Lock 1 is the approve, every later one an override with a reason.
model ShowFileLock {
  id            String         @id @default(cuid())
  number        Int
  deliverable   Deliverable    @relation(fields: [deliverableId], references: [id])
  deliverableId String
  version       ContentVersion @relation(fields: [versionId], references: [id])
  versionId     String
  kind          LockKind
  reason        String         @default("")
  at            DateTime

  @@unique([deliverableId, number])
}

enum Audience {
  room
  attendees
}

/// A built playback (room) or post-show (attendees) package (D-016).
/// Append-only (trigger). Stale when the manifest built now has another checksum.
model DistributionPackage {
  id            String   @id @default(cuid())
  audience      Audience
  number        Int
  /// The agenda version the running order was read from.
  agendaVersion Int
  manifest      Json
  /// SHA-256 of the manifest's canonical JSON.
  sha256        String
  builtAt       DateTime
  event         Event    @relation(fields: [eventId], references: [id])
  eventId       String
  /// Set for a room package, null for attendees (CHECK in the migration).
  room          Room?    @relation(fields: [roomId], references: [id])
  roomId        String?

  @@index([eventId, audience, roomId])
}

/// How far before the show a kind of deliverable is due (P0-5 chase). Lead
/// time is data, per event and kind, like ValidationRule — the deadline
/// itself is never stored: it derives from the owner's first call time minus
/// this (src/chase/chase.ts), so a session move moves the deadline with it.
model DeadlinePolicy {
  id       String          @id @default(cuid())
  kind     DeliverableKind
  leadDays Int
  event    Event           @relation(fields: [eventId], references: [id])
  eventId  String

  @@unique([eventId, kind])
}

/// The reminder outbox. Append-only (trigger): what went out, as it went out.
/// One row per deliverable per cadence step — the unique key is the cadence,
/// so no step can be sent twice however often the producer clicks.
model Reminder {
  id            String      @id @default(cuid())
  deliverable   Deliverable @relation(fields: [deliverableId], references: [id])
  deliverableId String
  /// Days before due that this reminder covers; negative is after (overdue).
  step          Int
  to            String
  body          String
  sentAt        DateTime

  @@unique([deliverableId, step])
}

/// A company Showcall buys from. House-wide, like Staff: one caterer across
/// every event, one COI on file for all of them.
model Vendor {
  id     String               @id @default(cuid())
  name   String               @unique
  docs   ComplianceDoc[]
  lines  BudgetLine[]
  nags   ComplianceReminder[]
  blocks RoomBlock[]
}

enum ComplianceKind {
  coi
  w9
}

/// A compliance document received. Append-only (trigger): a renewal is a new
/// row, and the one in force is the latest received. A W-9 does not expire; a
/// COI must (check constraint).
model ComplianceDoc {
  id         String         @id @default(cuid())
  kind       ComplianceKind
  receivedOn DateTime       @db.Date
  expiresOn  DateTime?      @db.Date
  vendor     Vendor         @relation(fields: [vendorId], references: [id])
  vendorId   String
}

/// The compliance nag outbox (D-019) — Reminder's sibling, not a
/// generalization of it. Append-only. The cadence is the unique key again, and
/// `dueOn` is in it, so a renewal that moves the due day starts a fresh cadence.
model ComplianceReminder {
  id       String         @id @default(cuid())
  event    Event          @relation(fields: [eventId], references: [id])
  eventId  String
  vendor   Vendor         @relation(fields: [vendorId], references: [id])
  vendorId String
  kind     ComplianceKind
  dueOn    DateTime       @db.Date
  step     Int
  body     String
  sentAt   DateTime

  @@unique([eventId, vendorId, kind, dueOn, step])
}

enum BudgetCategory {
  venue
  av
  catering
  decor
  staffing
  talent
  travel
  production
  other
}

/// One line of an event's budget (P0-8). Integer cents, never negative.
/// Committed is what is contracted; actual is what has been invoiced. Lines
/// are working state — the history is the snapshots.
model BudgetLine {
  id             String             @id @default(cuid())
  category       BudgetCategory
  description    String
  committedCents Int
  actualCents    Int                @default(0)
  clientBillable Boolean            @default(true)
  event          Event              @relation(fields: [eventId], references: [id])
  eventId        String
  vendor         Vendor?            @relation(fields: [vendorId], references: [id])
  vendorId       String?
  attrition      AttritionDecision?

  @@index([eventId])
}

/// A frozen copy of the budget. Append-only (trigger), numbered per event.
/// `lines` is the full line list as it stood; totals are columns so a
/// comparison never re-adds JSON.
model BudgetSnapshot {
  id             String   @id @default(cuid())
  number         Int
  label          String
  takenAt        DateTime
  committedCents Int
  actualCents    Int
  billableCents  Int
  lines          Json
  event          Event    @relation(fields: [eventId], references: [id])
  eventId        String

  @@unique([eventId, number])
}

/// A negotiated hotel block (P0-5): rooms × nights × rate. The hotel is a
/// Vendor, so accepted exposure lands on the budget against it (D-020).
model RoomBlock {
  id           String               @id @default(cuid())
  event        Event                @relation(fields: [eventId], references: [id])
  eventId      String
  hotel        Vendor               @relation(fields: [hotelId], references: [id])
  hotelId      String
  rateCents    Int
  /// Pickup pace is measured from the day the contract was signed.
  contractedOn DateTime             @db.Date
  /// After this day the hotel takes unsold rooms back: nothing books or releases.
  cutoffOn     DateTime             @db.Date
  nights       BlockNight[]
  thresholds   AttritionThreshold[]
  reservations RoomReservation[]
  decisions    AttritionDecision[]
}

/// Rooms contracted on one night, as signed. Releases never edit this; they are decisions.
model BlockNight {
  id       String         @id @default(cuid())
  block    RoomBlock      @relation(fields: [blockId], references: [id])
  blockId  String
  night    DateTime       @db.Date
  rooms    Int
  released BlockRelease[]

  @@unique([blockId, night])
}

/// "Fill `percent`% of contracted room-nights by `dueOn`, or pay the shortfall at the block rate."
model AttritionThreshold {
  id        String              @id @default(cuid())
  block     RoomBlock           @relation(fields: [blockId], references: [id])
  blockId   String
  dueOn     DateTime            @db.Date
  percent   Int
  decisions AttritionDecision[]

  @@unique([blockId, dueOn])
}

enum GuestKind {
  attendee
  speaker
  staff
  vip
}

/// Rooms booked into the block. Speaker and staff rooms link their person (CHECK).
model RoomReservation {
  id        String    @id @default(cuid())
  block     RoomBlock @relation(fields: [blockId], references: [id])
  blockId   String
  kind      GuestKind
  guest     String
  rooms     Int       @default(1)
  arriveOn  DateTime  @db.Date
  departOn  DateTime  @db.Date
  bookedOn  DateTime  @db.Date
  speaker   Speaker?  @relation(fields: [speakerId], references: [id])
  speakerId String?
  staff     Staff?    @relation(fields: [staffId], references: [id])
  staffId   String?

  @@index([blockId])
}

enum AttritionChoice {
  release
  accept
}

/// A decision answering a threshold's alert. Append-only (trigger): the log is the record.
/// A release carries its per-night split; an accept carries the budget line it posted.
model AttritionDecision {
  id            String             @id @default(cuid())
  block         RoomBlock          @relation(fields: [blockId], references: [id])
  blockId       String
  threshold     AttritionThreshold @relation(fields: [thresholdId], references: [id])
  thresholdId   String
  choice        AttritionChoice
  roomNights    Int
  /// What an accept added to the budget (net of earlier accepts); 0 for a release.
  exposureCents Int
  decidedOn     DateTime           @db.Date
  decidedAt     DateTime
  releases      BlockRelease[]
  budgetLine    BudgetLine?        @relation(fields: [budgetLineId], references: [id], onDelete: Restrict)
  budgetLineId  String?            @unique
}

/// Rooms handed back to the hotel on one night. Append-only.
model BlockRelease {
  id         String            @id @default(cuid())
  decision   AttritionDecision @relation(fields: [decisionId], references: [id])
  decisionId String
  night      BlockNight        @relation(fields: [nightId], references: [id])
  nightId    String
  rooms      Int
}
