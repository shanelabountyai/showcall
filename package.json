{
  "name": "showcall",
  "private": true,
  "type": "module",
  "scripts": {
    "preflight": "if [ -x \"$HOME/.claude/bin/swapcheck\" ]; then \"$HOME/.claude/bin/swapcheck\" --quiet; fi",
    "predev": "npm run preflight",
    "dev": "next dev -p 4000",
    "build": "next build",
    "start": "next start -p 4000",
    "postinstall": "prisma generate",
    "pretest": "npm run typecheck",
    "test": "dotenv -e .env.test -- vitest run",
    "test:watch": "dotenv -e .env.test -- vitest",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:test": "dotenv -e .env.test -- prisma migrate deploy",
    "db:migrate:all": "npm run db:migrate && npm run db:migrate:test",
    "db:status": "prisma migrate status && dotenv -e .env.test -- prisma migrate status",
    "db:seed": "dotenv -e .env -- tsx prisma/seed.ts",
    "db:seed:test": "dotenv -e .env.test -- tsx prisma/seed.ts",
    "demo": "dotenv -e .env -- tsx scripts/demo.ts",
    "dev:test": "dotenv -e .env.test -- next dev -p 4000",
    "build:test": "dotenv -e .env.test -- next build",
    "start:test": "dotenv -e .env.test -- next start -p 4000",
    "e2e:server": "npm run build:test && npm run start:test",
    "pretest:e2e": "npm run db:migrate:test && npm run db:seed:test",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "dotenv": "^17",
    "dotenv-cli": "^11.0.0",
    "prisma": "^7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^5.6",
    "vitest": "^2.1"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "next": "^16.3.4",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
