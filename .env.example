# Every variable the app reads (src/env.ts validates them at boot; src/env.test.ts keeps this list in step).
# Local Postgres only. Seed data is synthetic; never point this at a cloud database.
DATABASE_URL="postgresql://USER@localhost:5432/showcall_dev?connection_limit=10&pool_timeout=20"
SHADOW_DATABASE_URL="postgresql://USER@localhost:5432/showcall_shadow"
# Reaching a cloud database has to be typed: set only on the deployed demo (D-032).
SHOWCALL_ALLOW_CLOUD_DB=
# The deployed demo's shared password (D-032). Unset locally = no gate; unset on Vercel = every request is a 503.
DEMO_ACCESS_PASSWORD=
# Vercel Cron's bearer for /api/cron/*. Unset in production = the cron refuses.
CRON_SECRET=
# Showcall Live test hooks (?dropAfter=, D-043): set LIVE_TEST_HOOKS=1 in .env.test only, never on Vercel.
LIVE_TEST_HOOKS=
# Live stream tuning in ms (src/live/routes.ts); unset = the built-in defaults.
LIVE_POLL_MS=
LIVE_MAX_MS=
# Set by Next.js and Vercel, never by hand: NODE_ENV, VERCEL.
